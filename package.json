{
  "name": "another-planet",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "workspaces": ["client", "server"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch server/index.ts\" \"vite client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite client",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build client && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "test": "tsx --test server/*.test.ts shared/minigames/*.test.ts client/src/minigames/core/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
